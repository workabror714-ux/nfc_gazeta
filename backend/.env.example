# Django
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
SECURE_SSL_REDIRECT=False

# Database
# Leave empty locally to use SQLite.
DATABASE_URL=

# Supabase Storage S3
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=newspaper-media
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=us-east-1
# Example: PROJECT_REF.supabase.co/storage/v1/object/public/newspaper-media
AWS_S3_CUSTOM_DOMAIN=

# Upload and OCR
MAX_PDF_SIZE_MB=100
OCR_ENABLED=True
OCR_LANGUAGES=uzb+uzb_cyrl+rus+eng
OCR_DPI=300
OCR_MIN_TEXT_LENGTH=80
OCR_TESSDATA_PATH=tessdata
